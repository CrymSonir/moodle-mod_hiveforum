{{!
    @template mod_hiveforum/noscript_forum

    Server-side fallback of the discussion list, shown when JavaScript is disabled.

    Example context (json):
    {
        "fulleditorurl": "#",
        "capabilities": {"canstart": true},
        "discussions": [{"name": "Hello", "url": "#", "replycount": 2, "author": {"fullname": "Ada"}}]
    }
}}
<div class="hf-noscript">
    {{#capabilities.canstart}}
        <p><a class="btn btn-primary" href="{{fulleditorurl}}">{{#str}}newdiscussion, mod_hiveforum{{/str}}</a></p>
    {{/capabilities.canstart}}
    <ul class="list-unstyled">
        {{#discussions}}
            <li class="mb-2">
                <a href="{{url}}"><strong>{{{name}}}</strong></a>
                <span class="text-muted"> &middot; {{author.fullname}} &middot; {{#str}}repliescount, mod_hiveforum, {{replycount}}{{/str}}</span>
            </li>
        {{/discussions}}
        {{^discussions}}
            <li>{{#str}}emptydiscussions, mod_hiveforum{{/str}}</li>
        {{/discussions}}
    </ul>
</div>
