{{!
    @template mod_hiveforum/noscript_thread

    Server-side fallback of a discussion, shown when JavaScript is disabled.

    Example context (json):
    {
        "forumurl": "#",
        "discussion": {"name": "Hello", "id": 1},
        "posts": [{"id": 1, "message": "<p>Hi</p>", "timecreatedstr": "Today", "author": {"fullname": "Ada"}}]
    }
}}
<div class="hf-noscript">
    <p><a href="{{forumurl}}">&larr; {{forumname}}</a></p>
    <h3>{{{discussion.name}}}</h3>
    {{#posts}}
        <article class="border rounded p-3 mb-3" id="p{{id}}">
            <p class="text-muted mb-2"><strong>{{author.fullname}}</strong> &middot; {{timecreatedstr}}</p>
            <div>{{{message}}}</div>
        </article>
    {{/posts}}
    {{#capabilities.canreply}}
        <form method="post" action="post.php">
            <input type="hidden" name="discussion" value="{{discussion.id}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <label for="hf-noscript-reply" class="visually-hidden">{{#str}}reply, mod_hiveforum{{/str}}</label>
            <textarea id="hf-noscript-reply" class="form-control mb-2" name="message" rows="4" required></textarea>
            <button type="submit" class="btn btn-primary">{{#str}}reply, mod_hiveforum{{/str}}</button>
        </form>
    {{/capabilities.canreply}}
</div>
