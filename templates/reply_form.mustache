{{!
    @template mod_hiveforum/reply_form
}}
<form method="post" action="{{posturl}}" class="hiveforum-reply-form">
    <input type="hidden" name="discussion" value="{{discussionid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <textarea name="message" rows="4" placeholder="{{strreply}}..." required></textarea>
    <div class="hiveforum-reply-actions">
        <button type="submit" class="hiveforum-btn hiveforum-btn-primary">{{strreply}}</button>
    </div>
</form>
